+// Night Shift lab hooks (debug builds only, default off), reusable for any audio-thread race:
+//   adb shell setprop debug.zesty.hook.slow_audio_ms 150   -> each playback audio callback takes ~150 ms longer
+//                                                            (a slow phone: the field OPPO logged a 159 ms callback)
+//   adb shell setprop debug.zesty.hook.audio_probe 1       -> logs "NS_PROBE audio_cb" about 4 times a second while the
+//                                                            playback callback really pulls samples (not silent)
+static int ns_prop_int(const char *name) {
+    char v[PROP_VALUE_MAX] = {0};
+    if (__system_property_get(name, v) <= 0) return 0;
+    return atoi(v);
+}
