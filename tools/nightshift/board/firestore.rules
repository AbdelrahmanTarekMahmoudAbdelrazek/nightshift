rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Staff = a verified @msd-my.com address (email-link sign-in verifies it), optionally also on the allowlist.
    function staff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@msd-my[.]com$');
    }
    function allowlisted() {
      return exists(/databases/$(db)/documents/staff/$(request.auth.token.email.lower()));
    }
    // Set `requireAllowlist: true` in config/board to also require an allowlist row (e.g. for Demo Day guests).
    // Guest mode (26 Oct, asked by the board owner): anyone who presses "Enter as guest" may READ the board until the
    // date below. Guests can never queue jobs or change anything. To turn guests off earlier, change the date and redeploy.
    function guest() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.time < timestamp.date(2026, 11, 2);
    }
    function reader() {
      return staff() && (!get(/databases/$(db)/documents/config/board).data.get('requireAllowlist', false) || allowlisted());
    }

    match /config/{doc}    { allow read: if reader() || guest(); allow write: if false; }
    match /audiochecks/{id} { allow read: if reader() || guest(); allow write: if false; }
    match /cards/{id}       { allow read: if reader() || guest(); allow write: if false; }
    match /cardreviews/{id} { allow read: if reader() || guest(); allow write: if false; }   // card root-cause reviews (worker writes)
    match /staff/{email}   { allow read: if reader() || guest(); allow write: if false; }
    match /cases/{id}      { allow read: if reader() || guest(); allow write: if false; }   // worker writes via Admin SDK
    match /families/{id}   { allow read: if reader() || guest(); allow write: if false; }   // same-bug families (worker writes)
    match /findings/{id}   { allow read: if reader() || guest(); allow write: if false; }
    match /runlog/{id}     { allow read: if reader() || guest(); allow write: if false; }
    match /joinrequests/{code} {                                               // "Connect this computer" (setup.sh): any staff
      allow create: if staff() && code.matches('^[0-9a-f]{12}$')
        && request.resource.data.keys().hasOnly(['email', 'at', 'ua'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.at == request.time;
      allow read: if staff() && resource.data.email == request.auth.token.email.lower();   // only the requester sees the answer
      allow update: if staff() && resource.data.email == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delivered']) && request.resource.data.delivered == true;
    }
    match /devicechoice/{email} {                                              // the phone each person picks on the board
      allow read: if reader() || guest();
      allow write: if reader() && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['serial', 'at'])
        && request.resource.data.serial is string && request.resource.data.serial.size() <= 80
        && request.resource.data.at == request.time;
    }
    match /workers/{id}    { allow read: if reader() || guest(); allow write: if false; }   // whose Night Shift worker is online (workers write)
    match /integrations/{id} { allow read: if reader() || guest(); allow write: if false; }   // waiting for integration (worker writes)
    match /play_issues/{id} { allow read: if reader() || guest(); allow write: if false; }   // Play vitals rows (worker writes; the board reads)
    match /prs/{id} {                                                          // PR reviews, worker writes
      allow read: if reader() || guest();
      allow write: if false;
      // Decide page answers (Agree / Not a problem / Ask author): one doc per finding per head, written as the signed-in
      // reader. The worker reads them to tune the reviewers. Nothing else on the PR can be changed from the browser.
      match /feedback/{fid} {
        allow read: if reader() || guest();
        allow create, update: if reader()
          && fid.matches('^[0-9a-f]{0,12}_f[0-9]{1,3}$')
          && request.resource.data.keys().hasOnly(['finding', 'title', 'where', 'decision', 'text', 'scenario', 'tier', 'head', 'by', 'at'])
          && request.resource.data.decision in ['agree', 'no', 'ask']
          && request.resource.data.by == request.auth.token.email.lower()
          && request.resource.data.at == request.time
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
        allow delete: if false;
      }
    }
    match /merged/{id} {                                                       // Play x Firebase rows (worker writes)
      allow read: if reader() || guest();
      allow update: if reader()                                                // staff may edit only PR + note
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pr', 'note', 'noteBy', 'noteAt'])
        && request.resource.data.noteBy == request.auth.token.email.lower();
      allow create, delete: if false;
    }
    match /jobs/{id} {
      allow read: if reader() || guest();
      // The browser may only queue a job: one of the known actions, on an existing case, status 'queued', as itself.
      allow create: if reader()
        && request.resource.data.keys().hasOnly(['action', 'issue', 'requestedBy', 'status', 'queuedAt', 'summary', 'description', 'comments'])
        && request.resource.data.action in ['start', 'triage', 'analyse', 'reproduce', 'draft-fix', 'pull', 'sync', 'sync-full', 'pr-review', 'audio-branches', 'audio-check', 'card-read', 'symbols-rebuild', 'build-mode', 'symbols-hide', 'bb-comments', 'crash-pr', 'jira-create']
        // only the "ship it" jobs carry text: exactly what the developer saw (and maybe edited) on the board
        && (request.resource.data.action == 'jira-create'
              ? (request.resource.data.summary is string && request.resource.data.summary.size() > 0 && request.resource.data.summary.size() <= 250
                 && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 30000
                 && !request.resource.data.keys().hasAny(['comments']))
           : request.resource.data.action == 'crash-pr'
              ? ((!request.resource.data.keys().hasAny(['summary']) || (request.resource.data.summary is string && request.resource.data.summary.size() <= 250))
                 && (!request.resource.data.keys().hasAny(['description']) || (request.resource.data.description is string && request.resource.data.description.size() <= 30000))
                 && !request.resource.data.keys().hasAny(['comments']))
           : request.resource.data.action == 'bb-comments'
              ? ((!request.resource.data.keys().hasAny(['description']) || (request.resource.data.description is string && request.resource.data.description.size() <= 30000))
                 && (!request.resource.data.keys().hasAny(['comments']) || (request.resource.data.comments is list && request.resource.data.comments.size() <= 20))
                 && !request.resource.data.keys().hasAny(['summary']))
           : !request.resource.data.keys().hasAny(['summary', 'description', 'comments']))
        && request.resource.data.status == 'queued'
        && request.resource.data.requestedBy == request.auth.token.email.lower()
        && request.resource.data.queuedAt == request.time
        && (request.resource.data.action == 'pr-review'
              ? (request.resource.data.issue.matches('^([a-z0-9._-]{1,60}-)?[0-9]{0,6}$')   // '' = all open PRs, or one PR (number, or <repo>-<number> for another repo),
                 || (request.resource.data.issue.size() <= 700                      // or redraw one diagram: id|flow or sN|note
                     && request.resource.data.issue.matches('^([a-z0-9._-]{1,60}-)?[0-9]{1,6}[|](flow|s[0-9]{1,3})([|].*)?$')))
              : request.resource.data.action == 'bb-comments'
              ? request.resource.data.issue.matches('^([a-z0-9._-]{1,60}-)?[0-9]{1,6}$')     // post one PR's Night Shift review to Bitbucket
              : request.resource.data.action == 'crash-pr'
              ? request.resource.data.issue.matches('^[0-9a-f]{32}(~[0-9a-f]{8})?([|][A-Za-z0-9._/-]{1,100})?$')   // case|base branch
              : request.resource.data.action == 'jira-create'
              ? request.resource.data.issue.matches('^[0-9a-f]{32}(~[0-9a-f]{8})?$')
              : request.resource.data.action == 'card-read'
              ? (request.resource.data.issue.matches('^[A-Z][A-Z0-9]{1,9}-[0-9]{1,7}([|].+)?$') && request.resource.data.issue.size() <= 1600)   // a Jira key, optional |developer note
              : request.resource.data.action == 'audio-check'
              ? request.resource.data.issue.matches('^[A-Za-z0-9._/-]{1,100};splits;[A-Za-z0-9._/-]{0,100}$')   // branch;project;control
              : request.resource.data.action == 'audio-branches'
              ? request.resource.data.issue.matches('^[A-Za-z0-9._/-]{0,100}$')   // '' = latest branches, else a name search
              : request.resource.data.action == 'symbols-rebuild'
              ? request.resource.data.issue.matches('^[0-9]{6,12}$')               // one version code (same-binary builds come along)
              : request.resource.data.action == 'symbols-hide'
              ? request.resource.data.issue.matches('^[0-9]{6,12}[|](hide|show)$')         // one build's shared symbols: hide/show
              : request.resource.data.action == 'build-mode'
              ? request.resource.data.issue.matches('^[0-9a-f]{32}(~[0-9a-f]{8})?[|](play|debug|auto|next)$')   // which app the lab phone runs for one crash
              : request.resource.data.action in ['sync', 'sync-full']
              ? request.resource.data.issue == ''                                  // whole-app gathering, no case
              : request.resource.data.action in ['pull', 'start']
                ? request.resource.data.issue.matches('^[0-9a-f]{32}(~[0-9a-f]{8})?$')   // a Crashlytics issue, or one crash (card) of a mixed issue
                : exists(/databases/$(db)/documents/cases/$(request.resource.data.issue)));
      // Cancel: any reader may stop a queued/running job; nothing else about the job can be changed from the browser.
      allow update: if reader()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'error', 'cancelledBy'])
        && ((resource.data.status == 'running' && request.resource.data.status == 'cancel')
            || (resource.data.status == 'queued' && request.resource.data.status == 'cancelled'));
      allow delete: if false;                                                    // only the worker moves a job on
    }
  }
}
